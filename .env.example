APP_NAME=Stewy OS
APP_ENV=production
APP_TIMEZONE=America/Toronto
APP_REFRESH_SECONDS=30
INTEGRATION_CACHE_SECONDS=20
DATABASE_URL=sqlite:///./data/stewy.db

# Optional Stewy OS HTTP Basic protection. Leave STEWY_PASSWORD empty for LAN/Tailscale testing.
STEWY_USERNAME=andy
STEWY_PASSWORD=

# Lexus Personal Hub. When Stewy OS runs in Docker on the same Pi as Lexus Hub,
# use host.docker.internal plus the Lexus Hub host port.
LEXUS_BASE_URL=http://host.docker.internal:8000
LEXUS_TIMEOUT_SECONDS=5

# ChatGPT Calorie Bridge
CALORIE_BASE_URL=
CALORIE_API_KEY=
CALORIE_TIMEOUT_SECONDS=5

# Movie Ticket Monitor public status feed
MOVIE_STATUS_URL=https://raw.githubusercontent.com/MushroomStew01/movie-ticket-discord-monitor/main/status.json
MOVIE_TIMEOUT_SECONDS=5
MOVIE_STALE_HOURS=36

# Home Assistant. Reuse the same local HA address/token pattern as Lexus Hub.
HA_BASE_URL=http://host.docker.internal:8123
HA_TOKEN=
HA_TIMEOUT_SECONDS=5
# Optional comma-separated entity IDs. Leave blank for person.* and temperature auto-discovery.
HA_PRESENCE_ENTITIES=
HA_TEMPERATURE_ENTITIES=
HA_SELECTED_ENTITIES=
HA_MAX_TEMPERATURE_SENSORS=6
