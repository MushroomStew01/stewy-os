APP_NAME=Stewy OS
APP_ENV=production
APP_TIMEZONE=America/Toronto
APP_REFRESH_SECONDS=30
INTEGRATION_CACHE_SECONDS=20
DATABASE_URL=sqlite:///./data/stewy.db

# Optional Stewy OS HTTP Basic protection. Leave STEWY_PASSWORD empty for LAN/Tailscale testing.
STEWY_USERNAME=andy
STEWY_PASSWORD=

# Lexus Personal Hub. When Stewy OS runs in Docker on the same Pi as Lexus Hub,
# use host.docker.internal plus the Lexus Hub host port.
LEXUS_BASE_URL=http://host.docker.internal:8000
LEXUS_TIMEOUT_SECONDS=5

# ChatGPT Calorie Bridge
CALORIE_BASE_URL=
CALORIE_API_KEY=
CALORIE_TIMEOUT_SECONDS=5

# Movie Ticket Monitor public status feed
MOVIE_STATUS_URL=https://raw.githubusercontent.com/MushroomStew01/movie-ticket-discord-monitor/main/status.json
MOVIE_TIMEOUT_SECONDS=5
MOVIE_STALE_HOURS=36

# Home Assistant. Reuse the same local HA address/token pattern as Lexus Hub.
HA_BASE_URL=http://host.docker.internal:8123
HA_TOKEN=
HA_TIMEOUT_SECONDS=5
# Optional comma-separated entity IDs. Leave blank for automatic discovery.
HA_PRESENCE_ENTITIES=
HA_TEMPERATURE_ENTITIES=
HA_SELECTED_ENTITIES=
HA_MAX_TEMPERATURE_SENSORS=6

# GitHub Actions. Public repositories work without a token because Stewy OS
# caches this integration separately for 10 minutes.
GITHUB_OWNER=MushroomStew01
GITHUB_REPOSITORIES=stewy-os,lexus-personal-hub,chatgpt-calorie-bridge,movie-ticket-discord-monitor
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=5
GITHUB_POLL_SECONDS=600

# Docker Engine status. DOCKER_GID is used by Compose so the non-root Stewy OS
# process can read the mounted Docker socket. Set it to:
#   stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_TIMEOUT_SECONDS=3
DOCKER_GID=988

# Central notifications. Disabled by default so upgrading cannot duplicate alerts.
NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
# Optional digits-only Discord user ID. Warning/critical alerts will mention this user.
DISCORD_USER_ID=
NOTIFICATION_DISCORD_USERNAME=Stewy OS
# info, warning, or critical. Default warning avoids meal/presence notification noise.
NOTIFICATION_MIN_SEVERITY=warning
# Local APP_TIMEZONE quiet hours. Critical events bypass quiet hours.
NOTIFICATION_QUIET_START=23:00
NOTIFICATION_QUIET_END=07:00
NOTIFICATION_DEDUPE_MINUTES=60
NOTIFICATION_RETRY_MINUTES=5
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_EVENT_MAX_AGE_MINUTES=10
NOTIFICATION_TIMEOUT_SECONDS=5
