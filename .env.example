APP_NAME=Stewy OS
APP_ENV=production
APP_TIMEZONE=America/Toronto
APP_REFRESH_SECONDS=30
INTEGRATION_CACHE_SECONDS=20
DATABASE_URL=sqlite:///./data/stewy.db

# Optional Stewy OS HTTP Basic protection. Leave STEWY_PASSWORD empty for LAN-only testing.
STEWY_USERNAME=andy
STEWY_PASSWORD=

# Lexus Personal Hub
LEXUS_BASE_URL=http://127.0.0.1:8010
LEXUS_TIMEOUT_SECONDS=5

# ChatGPT Calorie Bridge
CALORIE_BASE_URL=
CALORIE_API_KEY=
CALORIE_TIMEOUT_SECONDS=5
